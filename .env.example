# --- Auth (OTP login gate for SOA Breakdown) ---
# 32+ byte random strings, e.g. `openssl rand -base64 32`. Keep these two distinct.
AUTH_CHALLENGE_SECRET=
AUTH_SESSION_SECRET=
# Comma-separated list of emails allowed to log in.
OTP_ALLOWLIST=

# --- SMTP (OTP delivery — same AWS SES setup as Two-Serendra-Superapp / internal-tools) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Email (Gmail OAuth2, used for bulk notice sending only, not OTP) ---
EMAIL_USER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REFRESH_TOKEN=

# --- Gotenberg (docx -> pdf conversion) ---
GOTENBERG_URL=
SERVICE_USER_GOTENBERG=
SERVICE_PASSWORD_GOTENBERG=

# --- RabbitMQ (bulk notice email queue) ---
RABBITMQ_URL=

# --- Resident breakdown API ---
RESIDENT_BREAKDOWN_BASE_URL=
RESIDENT_BREAKDOWN_API_KEY=

# --- Rate limiting ---
# Number of trusted reverse-proxy hops in front of the app; used to pick the
# real client IP out of X-Forwarded-For. Defaults to 1.
TRUSTED_PROXY_HOPS=1
